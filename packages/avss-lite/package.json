{
  "name": "avss-lite-Raka503",
  "version": "1.0.2",
  "description": "AVSS Lite - Security Toolkit",
  "type": "module",
  "main": ".index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "tsc --noEmit",
    "generate": "prisma generate",
    "clean": "rimraf dist"
  },
  "keywords": [
    "avidev",
    "security",
    "typescript",
    "backend",
    "prisma",
    "better-auth",
    "zod",
    "argon2"
  ],
  "author": "AVIDEV Studio",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "ora": "^9.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint-config-next": "^16.2.10",
    "prisma": "^6.16.2",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  }
}
